# Normalize text to LF in the repo; let Git pick native EOL on checkout.
* text=auto

# Binary assets — never apply EOL conversion (prevents PDF/image/font corruption
# on checkout when core.autocrlf is on). Some small PDFs lack NUL bytes and are
# otherwise misdetected as text.
*.pdf   binary
*.jpg   binary
*.jpeg  binary
*.png   binary
*.gif   binary
*.webp  binary
*.avif  binary
*.ico   binary
*.svg   -text
*.woff  binary
*.woff2 binary
*.ttf   binary
*.otf   binary
*.eot   binary
*.mp4   binary
*.webm  binary
*.mov   binary
*.docx  binary
