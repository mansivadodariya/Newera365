{
  "name": "newera365",
  "version": "0.1.0",
  "private": true,
  "description": "Newera365.com — forex/CFD broker website (CSL-NE365-2026-Q2)",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "type-check": "turbo run type-check",
    "test": "turbo run test",
    "clean": "turbo run clean",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "prepare": "husky || true"
  },
  "devDependencies": {
    "d3-geo": "^3.1.1",
    "husky": "^9.1.7",
    "lint-staged": "^15.2.10",
    "prettier": "^3.3.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "topojson-client": "^3.1.0",
    "turbo": "^2.3.3",
    "typescript": "^5.6.3"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,json,md}": "prettier --write"
  },
  "overrides": {
    "qs": "^6.15.2",
    "drizzle-kit": "0.23.2"
  },
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "packageManager": "npm@10.8.2",
  "dependencies": {
    "sharp": "^0.35.3"
  },
  "optionalDependencies": {
    "@img/sharp-linux-x64": "^0.35.3",
    "@img/sharp-win32-x64": "^0.35.3"
  }
}
