PORT=4000

# ── MT5 Manager Web API (real feed, NE-003) ───────────────────────────────────
# HTTP/JSON Manager Web API on the broker's MT5 server. When MT5_HOST+MT5_LOGIN+
# MT5_PASSWORD are all set the service serves live data; otherwise it serves the
# static fallback table (usesMT5Data=false). Verify with:
#   npx ts-node src/webapi/verify.ts
MT5_HOST=31.14.254.143
MT5_PORT=443
MT5_LOGIN=
# Use the manager **API Password** (not the Master password). Kept out of git.
MT5_PASSWORD=
# Optional: pin the self-signed leaf cert (sha256 hex, colons ok). Get it with:
#   openssl s_client -connect 31.14.254.143:443 </dev/null 2>/dev/null | openssl x509 -fingerprint -sha256 -noout
MT5_CERT_SHA256=
# Optional: API build advertised in the handshake (defaults to 5830).
MT5_WEBAPI_VERSION=

# ── Service auth / ops ────────────────────────────────────────────────────────
# Shared secret the CMS sends as `Authorization: Bearer <token>`. REQUIRED in prod
# (the service refuses to boot without it). Must match the CMS MT5_INTERNAL_API_TOKEN.
MT5_INTERNAL_API_TOKEN=
# Comma-separated browser origins if the service is ever hit directly (CMS calls
# are server-to-server and CORS-exempt). Leave blank otherwise.
MT5_CORS_ORIGIN=
# Token gating GET /health (must match what your uptime monitor sends).
HEALTH_CHECK_TOKEN=
