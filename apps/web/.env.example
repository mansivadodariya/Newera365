# Public site URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Payload CMS REST/GraphQL base (apps/cms)
NEXT_PUBLIC_CMS_URL=http://localhost:3001

# MT5 bridge service (apps/mt5-service) — must be NEXT_PUBLIC_ so next.config.mjs
# can whitelist it in the CSP connect-src. Leave blank unless the browser fetches MT5 directly.
NEXT_PUBLIC_MT5_SERVICE_URL=http://localhost:4000

# Cloudflare Turnstile (CAPTCHA) — NE-026
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Analytics — scripts load only after cookie consent (Analytics.tsx). Leave blank to disable.
# GA4 Measurement ID (e.g. G-XXXXXXXXXX)
NEXT_PUBLIC_GA_ID=
# Meta (Facebook) Pixel ID
NEXT_PUBLIC_META_PIXEL_ID=

# Benzinga News API
BENZINGA_API_KEY=bz.DVTTBHGXXIZ6QBEKVKXU7RIBBOGHX2OC
NEXT_PUBLIC_BENZINGA_API_KEY=bz.DVTTBHGXXIZ6QBEKVKXU7RIBBOGHX2OC
