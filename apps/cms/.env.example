# Payload
PAYLOAD_SECRET=change-me-in-production
PAYLOAD_PUBLIC_SERVER_URL=http://localhost:3001
PORT=3001

# Neon serverless PostgreSQL
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=verify-full

# CORS — allow the Next.js frontend
# REQUIRED in production — startup will fail if unset.
FRONTEND_URL=http://localhost:3000

# Transactional email (Resend) — used by Payload's built-in forgot-password flow
# and newsletter/contact/partners emails. Get the key at https://resend.com/api-keys
# REQUIRED in production. In dev, emails fall back to the Resend sandbox sender
# (onboarding@resend.dev) which works without domain verification.
# In production, verify newera365.com at https://resend.com/domains before deploying.
RESEND_API_KEY=
EMAIL_FROM=no-reply@newera365.com

# Health-check endpoint auth — clients must send `x-health-token: $HEALTH_CHECK_TOKEN`.
HEALTH_CHECK_TOKEN=

# Salt for consent IP hashing — prevents rainbow-table reversal of IPv4 addresses.
# Generate: openssl rand -hex 16
CONSENT_IP_SALT=

# MT5 bridge service — used by the /api/mt5/* proxy endpoints (NE-003)
# Defaults to http://localhost:4000 when blank (local dev with mt5-service mock).
# Set to the deployed mt5-service URL in staging/production.
MT5_SERVICE_URL=http://localhost:4000

# Shared secret between CMS and mt5-service (/instruments endpoints).
# Must match MT5_INTERNAL_API_TOKEN in apps/mt5-service/.env.
# Leave blank in dev (service logs a warning but remains accessible).
# Generate: openssl rand -hex 32
MT5_INTERNAL_API_TOKEN=

# Cloudflare R2 (S3-compatible) — media + gated PDFs (NE-027)
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=
R2_PUBLIC_URL=https://media.newera365.com

# Redis (deferred post-launch)
REDIS_URL=

# Newsletter / contact email routing
# Inbox that receives contact-form submissions (defaults to EMAIL_FROM if unset)
CONTACT_NOTIFY_EMAIL=
# Inbox that receives IB/partner applications (defaults to EMAIL_FROM if unset)
PARTNERS_NOTIFY_EMAIL=
# Rate limits (requests per minute per IP, defaults shown)
NEWSLETTER_RATE_LIMIT=5
# CONTACT_RATE_LIMIT and WEBINAR_RATE_LIMIT already default to 3 and 10 respectively

# Mailchimp newsletter (NE-043)
MAILCHIMP_API_KEY=
MAILCHIMP_AUDIENCE_ID=

# Zoom webinars — Server-to-Server OAuth (NE-033)
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
