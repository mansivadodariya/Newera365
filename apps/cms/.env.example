# Payload
PAYLOAD_SECRET=change-me-in-production
PAYLOAD_PUBLIC_SERVER_URL=http://localhost:3001
PORT=3001

# Neon serverless PostgreSQL
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=verify-full

# Direct (non-pooler) Neon endpoint for DDL — used by the migration + seed scripts
# in src/scripts/*. The pooled endpoint can't run some DDL/session-mode ops, so the
# scripts prefer this when set. Derive it by removing "-pooler" from the DATABASE_URL
# host (e.g. ep-xxx-pooler.<region> → ep-xxx.<region>). Optional in dev.
DATABASE_URL_DIRECT=

# CORS — allow the Next.js frontend
# REQUIRED in production — startup will fail if unset.
# Single canonical site URL: also used to build email links + redirect host checks.
FRONTEND_URL=http://localhost:3000

# Extra browser origins allowed for CORS/CSRF, comma-separated. Payload echoes
# Access-Control-Allow-Origin only for an EXACT match, so list every origin the
# site is reached from beyond FRONTEND_URL — e.g. the Vercel alias and www:
#   CORS_ORIGINS=https://newera365-app.vercel.app,https://www.newera365.com
CORS_ORIGINS=

# Transactional + newsletter email — ZeptoMail SMTP (Zoho's transactional service).
# Backs Payload's built-in forgot-password flow AND all newsletter/contact/partner/
# webinar emails through a single nodemailer transport.
# Credentials: ZeptoMail console → Mail Agent → SMTP. SMTP_PASS is the "Send Mail Token".
# REQUIRED in production — startup fails without SMTP_PASS. In dev, leave SMTP_PASS blank
# to use nodemailer's jsonTransport (emails are logged to the console, not sent).
# Verify the newera365.com sending domain (SPF + DKIM) in ZeptoMail before deploying.
SMTP_HOST=smtp.zeptomail.com      # EU: smtp.zeptomail.eu · IN: smtp.zeptomail.in
SMTP_PORT=465                     # 465 = SSL · 587 = STARTTLS
SMTP_USER=emailapikey             # literal string for every ZeptoMail SMTP account
SMTP_PASS=                        # ZeptoMail "Send Mail Token" — REQUIRED in production
EMAIL_FROM=no-reply@newera365.com # must be on the verified ZeptoMail domain

# Health-check endpoint auth — clients must send `x-health-token: $HEALTH_CHECK_TOKEN`.
HEALTH_CHECK_TOKEN=

# Salt for consent IP hashing — prevents rainbow-table reversal of IPv4 addresses.
# REQUIRED in production — startup will fail (in payload.config.ts) if unset.
# Generate: openssl rand -hex 16
CONSENT_IP_SALT=

# Run the (slug, locale) unique-index migration on server startup.
# Defaults to ON in production; set to "false" to skip (e.g. if applied manually).
# Idempotent (CREATE INDEX IF NOT EXISTS) and non-fatal on failure.
RUN_MIGRATIONS_ON_START=true

# MT5 bridge service — used by the /api/mt5/* proxy endpoints (NE-003)
# Defaults to http://localhost:4000 when blank (local dev with mt5-service mock).
# Set to the deployed mt5-service URL in staging/production.
MT5_SERVICE_URL=http://localhost:4000

# Shared secret between CMS and mt5-service (/instruments endpoints).
# Must match MT5_INTERNAL_API_TOKEN in apps/mt5-service/.env.
# Leave blank in dev (service logs a warning but remains accessible).
# Generate: openssl rand -hex 32
MT5_INTERNAL_API_TOKEN=

# Timeout (ms) for the CMS→mt5-service fetch in the /api/mt5 proxy and sync job.
# Defaults to 5000. On timeout the proxy falls back to CMS manual instrument data.
MT5_FETCH_TIMEOUT_MS=5000

# Media upload directory (Payload `staticDir`). Defaults to the repo-local ./media
# in dev. The container filesystem is EPHEMERAL on Railway/EC2 — without a
# persistent mount, every redeploy wipes uploaded media while the DB rows survive,
# so the frontend gets valid URLs that 404. In production set this to a mounted
# volume path (e.g. /data/media) and attach a Railway volume at that path.
# Superseded by R2 once NE-027 lands.
MEDIA_DIR=

# Cloudflare R2 (S3-compatible) — media + gated PDFs (NE-027)
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=
R2_PUBLIC_URL=https://media.newera365.com

# Rate limiting is backed by Postgres (DATABASE_URL) via a small custom store
# (table rate_limit_hits, auto-created on startup). No Redis required. If the table
# can't be provisioned the API falls back to in-memory limiting automatically.

# Newsletter / contact email routing
# Inbox that receives contact-form submissions (defaults to EMAIL_FROM if unset)
CONTACT_NOTIFY_EMAIL=
# Inbox that receives IB/partner applications (defaults to EMAIL_FROM if unset)
PARTNERS_NOTIFY_EMAIL=
# Rate limits (requests per minute per IP, defaults shown)
NEWSLETTER_RATE_LIMIT=5
# CONTACT_RATE_LIMIT and WEBINAR_RATE_LIMIT already default to 3 and 10 respectively
# Rate-limit window in ms (the "per minute" above). Default 60000.
RATE_LIMIT_WINDOW_MS=60000
# Max documents returned by the public list endpoints. Default 500.
MAX_PAYLOAD_RESULTS=500
# Trusted proxy hops for Express (X-Forwarded-For) so client IPs used for rate
# limiting are read correctly behind a proxy. Default 1 (single edge in front).
TRUST_PROXY_HOPS=1

# Internal inbox that receives webinar registrations (defaults to EMAIL_FROM if unset)
WEBINAR_NOTIFY_EMAIL=
